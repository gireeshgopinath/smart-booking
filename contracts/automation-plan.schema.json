{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["taskId", "goal", "allowedPaths", "steps", "verificationScripts", "acceptanceMapping", "externalGates"],
  "properties": {
    "taskId": {"type": "string", "pattern": "^T[0-9]{2}$"},
    "goal": {"type": "string"},
    "allowedPaths": {"type": "array", "items": {"type": "string"}},
    "steps": {"type": "array", "items": {"type": "string"}},
    "verificationScripts": {"type": "array", "items": {"type": "string"}},
    "acceptanceMapping": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["criterion", "evidenceExpected"],
        "properties": {"criterion": {"type": "string"}, "evidenceExpected": {"type": "array", "items": {"type": "string"}}}
      }
    },
    "externalGates": {"type": "array", "items": {"type": "string"}}
  }
}
